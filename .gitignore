# Compiled provider binaries & local cache
**/.terraform/
**/.terraform/*

# State files & local backups
*.tfstate
*.tfstate.*
*.tfstate.backup

# Transient locks and crash dumps
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Variable definition files (can contain secrets)
*.tfvars
*.tfvars.json

# Plan files (can contain unencrypted state data)
*.tfplan
*tfplan*
planout

# Local CLI configuration
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json